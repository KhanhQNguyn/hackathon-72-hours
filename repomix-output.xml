  document.getElementById('content').innerText = 'x'.repeat(9000);
  var longResult = JSON.parse(window.__domReader_getVisibleText());
  var longPass = longResult.truncated === true && longResult.text.length === 8000;
  console.log('M12_LONG_PASS:' + longPass);

  // --- MutationObserver -> bridge round trip ---
  setTimeout(function () {
    var span = document.createElement('span');
    span.textContent = 'dynamically added';
    document.body.appendChild(span);
  }, 50);
</script>
