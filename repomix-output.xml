  testWidgets('milestone27 — trigger enabled in Idle, fires TriggerPressed', (
    tester,
  ) async {
    final handle = tester.ensureSemantics();
    final fsm = ApplicationFlowFsm();
    await tester.pumpWidget(_app(fsm));

